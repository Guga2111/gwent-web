# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Database (Supabase in prod, local Postgres in dev)
DB_URL=jdbc:postgresql://localhost:5432/gwent
DB_USERNAME=gwent
DB_PASSWORD=changeme

# JWT
JWT_SECRET=replace-with-a-secure-random-string-minimum-32-chars
JWT_EXPIRATION_MS=604800000

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# GitHub (only needed locally if pulling the prod image)
GITHUB_REPOSITORY_OWNER=your-github-username